{
  "name": "dsh-neural-startup",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 神经核心开机动画",
  "repository": { "type": "git", "url": "git+https://github.com/TangMuLiEath/dsh-neural-startup.git" },
  "homepage": "https://github.com/TangMuLiEath/dsh-neural-startup#readme",
  "bugs": { "url": "https://github.com/TangMuLiEath/dsh-neural-startup/issues" },
  "type": "module",
  "main": "lib/index.js",
  "keywords": ["dsh-plugin", "deepseek-harness", "startup", "canvas", "boot-animation"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": { "test": "node --test test/*.test.mjs", "build": "python tools/build.py" },
  "engines": { "node": ">=22.19", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web",
      "immediately": true
    }
  }
}
